# Copy this file to a private location outside the repo, for example:
# ~/.vault-gate/vault-gate.env

VAULT_GATE_ROOT=/absolute/path/to/Private-Vault
VAULT_GATE_CAPTURE_DIR=00_Inbox/Capture
VAULT_GATE_PENDING_DIR=00_Inbox/Pending-Review
VAULT_GATE_LOG_DIR=99_Meta/automation-log

# Use a long random token. Never commit the real value.
VAULT_GATE_TOKEN=replace-with-a-long-random-token

# Optional git integration.
VAULT_GATE_AUTHOR=Vault Gate <vault-gate@example.com>
VAULT_GATE_AUTO_COMMIT=false

